{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/internal/portfolio-guide/cleanup",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "portfolio.musicofdanielnash.com"
        }
      ],
      "destination": "https://www.danielnash.co/$1",
      "permanent": true
    }
  ]
}
