# ResumeCustomizer connection — server-side only, never exposed to the client.
# Powers BOTH the resume generator proxy and the chatbot's Claim-to-Evidence
# tool. The token must match RESUME_CUSTOMIZER_API_TOKEN in ResumeCustomizer.
RESUME_CUSTOMIZER_API_BASE_URL=http://localhost:3001
RESUME_CUSTOMIZER_API_TOKEN=

# Local testing for the chatbot's evidence tool WITHOUT running ResumeCustomizer.
# Non-production only. When true, the evidence tool is served by an in-process
# mock (lib/portfolio-guide/tools/mockEvidence.ts) and the happy path works on
# localhost. Optionally pin a scenario, or drop a FORCE_EVIDENCE_* token into a
# chatbot question to exercise a single fallback branch from one running server:
#   evidence (default) | empty | invalid_shape | http_error | network_error | timeout
PORTFOLIO_GUIDE_EVIDENCE_ENABLE_MOCK=
PORTFOLIO_GUIDE_EVIDENCE_MOCK_SCENARIO=
PORTFOLIO_GUIDE_DURABLE_CONVERSATIONS=
# Long random value used only to HMAC request IPs for durable rate limiting.
PORTFOLIO_GUIDE_PRIVACY_SALT=
# Authorizes the scheduled 90-day retention cleanup endpoint.
CRON_SECRET=

HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_FORM_ID=
SITE_BASE_URL=https://www.danielnash.co

RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
DATABASE_URL=
